# Copy to .env on the server. Local development needs none of this.

# Public domain; Caddy obtains its certificate automatically. DNS must point here first.
SITE_ADDRESS=stockroom.example.com

# Password for anything that changes state (placing orders, carrier settings).
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains '$'.
DEMO_USER=reviewer
DEMO_PASSWORD_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
