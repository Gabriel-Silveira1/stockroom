# Public deployment: automatic HTTPS for SITE_ADDRESS. Reading is open, so reviewers can
# browse the dashboard and API docs; anything that changes state asks for a password.
{$SITE_ADDRESS} {
	@writes {
		path /api/*
		method POST PUT PATCH DELETE
	}
	basic_auth @writes {
		{$DEMO_USER} {$DEMO_PASSWORD_HASH}
	}
	import routes.caddy
}
